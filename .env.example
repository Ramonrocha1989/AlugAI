# URL do backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Modo mock (true = usa dados mockados, false = usa backend real)
NEXT_PUBLIC_USE_MOCK=true

# Chave secreta para verificação de JWT (obrigatório em produção)
JWT_SECRET=<sua_chave_secreta_aqui>

# Mercado Pago
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=<public_key>
MERCADOPAGO_ACCESS_TOKEN=<access_token>

# Google Analytics
NEXT_PUBLIC_GA_ID=<ga_id>

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<cloud_name>

# URL pública do site
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Sentry (frontend Next.js — projeto baitabriq-web)
NEXT_PUBLIC_SENTRY_DSN=
# Opcional no build (Netlify/CI): upload de source maps
# SENTRY_AUTH_TOKEN=
